# Función: mostrar las variables locales de MySQL sin incluir credenciales reales.
# Secretos: copiar a .env (ignorado) y reemplazar ambos valores antes de ejecutar.
MYSQL_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_LOCAL_ALEATORIA
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_OTRA_CLAVE_LOCAL_ALEATORIA
# Puertos del PC: se publican únicamente en loopback, no en toda la red.
MYSQL_PORT=3307
MYSQL_TEST_PORT=3308
